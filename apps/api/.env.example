# Local dev (no Docker). See root .env.example for the full dev/prod matrix.
DATABASE_URL="file:../../../.local/dev.db"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../../.local/uploads
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=dev-jwt-secret-change-me
SEED_KIOSK_SECRET=dev-secret-001

# Payments — unset keys = mock-pay flow; set test/sandbox keys for Razorpay checkout.
# PAYMENTS_MODE: auto = Razorpay when keys present; mock = instant capture (e2e suites).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
PAYMENTS_MODE=auto
# Must match the webhook secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret
SWEEP_INTERVAL_SEC=15
OTP_TTL_MIN=30

# Admin (Phase 5) — dev plain password; production sets ADMIN_PASSWORD_HASH (bcrypt)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin-dev-123

# Alerts (Phase 5) — Telegram bot; log-only when unset
# TELEGRAM_BOT_TOKEN= TELEGRAM_CHAT_ID=
