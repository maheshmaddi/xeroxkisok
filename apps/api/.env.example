# Local dev (no Docker). See root .env.example for the full dev/prod matrix.
DATABASE_URL="file:../../../.local/dev.db"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../../.local/uploads
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=dev-jwt-secret-change-me
SEED_KIOSK_SECRET=dev-secret-001

# Payments — unset keys = mock-pay flow; set sandbox keys for Razorpay checkout.
# RAZORPAY_KEY_ID= RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret
SWEEP_INTERVAL_SEC=15
OTP_TTL_MIN=30
